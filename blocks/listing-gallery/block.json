{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "fleetwire/listing-gallery",
    "title": "Fleetwire Vehicle Gallery",
    "category": "fleetwire",
    "icon": "format-gallery",
    "description": "Every photo of one vehicle with thumbnails.",
    "keywords": [
        "photos",
        "images",
        "gallery",
        "vehicle"
    ],
    "textdomain": "fleetwire",
    "attributes": {
        "listingId": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true
        }
    },
    "editorScript": "fleetwire-blocks-editor",
    "editorStyle": "fleetwire-blocks-editor"
}
